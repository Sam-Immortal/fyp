# ScamGuard Backend Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://scamguard:scamguard@postgres:5432/scamguard

# Redis (Taskiq broker + result backend)
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-in-production-min-16-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Security
SAFETY_THRESHOLD=0.75
CORS_ORIGINS=*

# Hugging Face (for NLP worker)
HF_TOKEN=
HF_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
HF_INFERENCE_BASE_URL=https://router.huggingface.co/v1

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=scamguard
MINIO_SECRET_KEY=scamguard-secret
MINIO_BUCKET=ci-artifacts

# Audio
AUDIO_SAMPLE_RATE=16000
AUDIO_N_MELS=80
AUDIO_N_FFT=512
AUDIO_HOP_LENGTH=160
AUDIO_WIN_LENGTH=400
AUDIO_WINDOW=hann
AUDIO_POWER=2.0
AUDIO_FMIN=0.0
AUDIO_FMAX=
AUDIO_NORM=slaney
AUDIO_MEL_SCALE=htk

# App
APP_NAME=ScamGuard API
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000