# ScamGuard Backend - Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

APP_NAME="ScamGuard API"
ENVIRONMENT=development
DEBUG=false

HOST=0.0.0.0
PORT=8000

# PostgreSQL (async SQLAlchemy DSN)
DATABASE_URL=postgresql+asyncpg://scamguard:scamguard@postgres:5432/scamguard

# Redis (cache + Taskiq broker + JWT deny-list)
REDIS_URL=redis://redis:6379/0

# MinIO (S3-compatible artifact/blob storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=scamguard
MINIO_SECRET_KEY=scamguard-secret
MINIO_BUCKET=ci-artifacts

# JWT auth (HS256). Access tokens are short-lived, refresh tokens rotate.
JWT_SECRET=please-change-this-to-a-strong-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Hugging Face (free tier). Required for NLP scoring via Inference API.
HF_TOKEN=hf_replace_with_your_token
HF_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Audio anti-spoofing model (Week 2). Pre-trained weights from Hugging Face.
AUDIO_MODEL_NAME=stapes-ai/aasist

# Audio processing settings (Mel spectrogram for AASIST)
AUDIO_SAMPLE_RATE=16000
AUDIO_N_MELS=80
AUDIO_N_FFT=512
AUDIO_HOP_LENGTH=160
AUDIO_WIN_LENGTH=400
AUDIO_WINDOW=hann
AUDIO_POWER=2.0
AUDIO_FMIN=0.0
AUDIO_FMAX=
AUDIO_NORM=slaney
AUDIO_MEL_SCALE=htk

# Anomaly-score safety threshold (0.0 - 1.0)
SAFETY_THRESHOLD=0.75

# CORS - comma-separated origins, or "*" for any
CORS_ORIGINS=*
